# PostgreSQL Connection String (Railway, Render, Supabase, or Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/b2b_intelligence

# Password required to unlock the web UI (saved in browser localStorage after first login)
APP_PASSWORD=change-me-to-a-strong-password

# Automatically stream a starter batch of CC0 datasets if the database is empty on first boot
AUTO_SYNC_STARTER=true
